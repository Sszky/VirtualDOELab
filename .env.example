# Copy this file to .env for local development (npm run dev).
# On Vercel, add the same names under Project → Settings → Environment Variables.
# Never commit the real .env file.

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=727908987568-u75jn6bubub7f67jfqr3fvpntkf08jbc.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-put-your-client-secret-here

# API key used by the Google Picker (restrict it to your domains in Cloud Console)
GOOGLE_API_KEY=put-your-api-key-here
# Google Cloud project number
GOOGLE_APP_ID=727908987568

# Random string, at least 32 characters, used to encrypt the session cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Websites (other than the API's own domain) allowed to call the API, comma-separated.
# Needed while the frontend is still on GitHub Pages.
ALLOWED_ORIGINS=https://sszky.github.io

# Google session: signed out after this many seconds without activity (default 1 hour)
SESSION_IDLE_S=3600
# ...and never lasts longer than this in total (default 8 hours)
SESSION_MAX_AGE_S=28800

# ---------------------------------------------------------------------------
# Experiment history ("My sessions") — optional. Leave empty to turn it off.
# ---------------------------------------------------------------------------
# Supabase → Project → Connect → Transaction pooler (port 6543) → copy the URI, put your DB password in it.
# Run server/schema.sql once in Supabase → SQL Editor before using it.
DATABASE_URL=

# Clerk (sign in with Google). History is only kept for signed-in users, so both
# DATABASE_URL and these keys are needed. Clerk Dashboard → Configure → Developers → API keys.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Vercel Cron secret for GET /api/cron/keepalive (keeps the free Supabase project from pausing).
# Only needed on Vercel. Random letters/numbers, at least 16 characters.
CRON_SECRET=
